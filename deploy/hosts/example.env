# Copy to deploy/hosts/<name>.env, one per server, and run:
#   make context HOST=<name>      # registers the SSH docker context once
#   make deploy STACK=nim HOST=<name>
#
# Only the *.env.example style templates belong in git — real host files with
# credentials are ignored by .gitignore.

# SSH target for `docker context create`. Key-based auth only.
SSH_TARGET=root@203.0.113.10

# Local name of the docker context that points at this host.
DOCKER_CONTEXT=nim-example

# Optional non-secret values substituted into deploy/stacks/*.yml.
# TRAEFIK_ACME_EMAIL=ops@example.invalid
# SWARMOPS_HOST=swarmops.example.invalid
# GRAFANA_HOST=grafana.example.invalid
# TRAEFIK_DASHBOARD_HOST=traefik.example.invalid
# TRAEFIK_DASHBOARD_URL=https://traefik.example.invalid/dashboard/
# TRAEFIK_CF_DNS_TOKEN_SECRET=traefik_cf_dns_token_v1
# TRAEFIK_ARVAN_API_KEY_SECRET=traefik_arvan_api_key_v1
# TRAEFIK_DASHBOARD_AUTH_SECRET=traefik_dashboard_auth_v1
# TRAEFIK_DYNAMIC_CONFIG_NAME=nim_traefik_dynamic_v1
# SWARMOPS_PLATFORM_MANIFEST_CONFIG_NAME=swarmops_platform_manifest_v1
# SWARMOPS_AGENT_SERVICE=swarmops-agent_agent
# SWARMOPS_AGENT_STACK_CONFIG_NAME=swarmops_agent_stack_v1
# SWARMOPS_LOGS_STACK_CONFIG_NAME=swarmops_logs_stack_v1
# SWARMOPS_OBSERVABILITY_STACK_CONFIG_NAME=swarmops_observability_stack_v1
# SWARMOPS_ALERTMANAGER_CONFIG_NAME=swarmops_alertmanager_config_v1
# SWARMOPS_ALLOY_CONFIG_NAME=swarmops_alloy_config_v1
# SWARMOPS_LOKI_CONFIG_NAME=swarmops_loki_config_v1
# SWARMOPS_PROMETHEUS_CONFIG_NAME=swarmops_prometheus_config_v1
# SWARMOPS_PROMETHEUS_RULES_CONFIG_NAME=swarmops_prometheus_rules_v1
# SWARMOPS_GRAFANA_DATASOURCES_CONFIG_NAME=swarmops_grafana_datasources_v1
# SWARMOPS_GRAFANA_DASHBOARD_PROVIDER_CONFIG_NAME=swarmops_grafana_dashboard_provider_v1
# SWARMOPS_GRAFANA_DASHBOARD_CONFIG_NAME=swarmops_grafana_dashboard_v1
# SWARMOPS_JAEGER_CONFIG_NAME=swarmops_jaeger_config_v1
# Keep these false until the initial inventory and access checks pass.
# SWARMOPS_MUTATIONS_ENABLED=false
# SWARMOPS_BUILD_ENABLED=false
# SWARMOPS_BUILD_MAX_BYTES=536870912
# SWARMOPS_BUILD_MAX_CPUS=2
# SWARMOPS_BUILD_MAX_MEMORY_MIB=2048
# SWARMOPS_IMAGE_PREFIXES=ghcr.io/nimasrn/
# REELFORGE_API_HOST=reelforge.example.invalid
