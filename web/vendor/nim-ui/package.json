{
  "name": "@nim.zone/ui",
  "version": "0.15.0",
  "type": "module",
  "description": "nim \u2014 the front-end design system and UI kit shared across nim products.",
  "keywords": [
    "design-system",
    "ui-kit",
    "react",
    "components",
    "tokens",
    "rtl",
    "persian",
    "tailwind",
    "accessible"
  ],
  "author": "Nima Sarayan",
  "license": "Apache-2.0",
  "homepage": "https://nim.zone/uikit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimasrn/nim-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nimasrn/nim-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
