{
  "name": "@nim.zone/ui",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "nim UI kit bundled with SwarmOps.",
  "author": "Nima Sarayan",
  "license": "Apache-2.0",
  "homepage": "https://nim.zone/uikit",
  "sideEffects": [
