{
  "name": "@nim.zone/ui",
  "version": "0.14.0",
  "type": "module",
  "description": "nim \u2014 the front-end design system and UI kit shared across nim products.",
  "keywords": [
    "design-system",
    "ui-kit",
    "react",
    "components",
    "tokens",
    "rtl",
    "persian",
    "tailwind",
    "accessible"
  ],
  "author": "Nima Sarayan",
  "license": "Apache-2.0",
  "homepage": "https://nim.zone/uikit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimasrn/nim-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nimasrn/nim-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nim.js"
    },
    "./styles.css": "./dist/nim.css",
    "./src/theme/index.css": "./src/theme/index.css",
    "./fonts.css": "./src/theme/fonts.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs lib",
    "build:docs": "node scripts/build.mjs docs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
